# ─── Python ──────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
*.egg
*.egg-info/
dist/
build/
*.spec
.Python
env/
venv/
.venv/
ENV/
pip-wheel-metadata/
*.log

# ─── Virtual Environments ─────────────────────────────────────────────────────
.env
.env.*
*.env

# ─── ML Models & Large Data Files ─────────────────────────────────────────────
models/*
